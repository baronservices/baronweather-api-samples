#rename this file to .env and populate with valid keys
#
# geotiff_fetch.py reads this file directly. Do not export these as environment
# variables — the environment is deliberately not read, so an exported value has
# no effect.
#
# The file is looked for in the current working directory first, then beside the
# script, so the tools work from any directory. Override with --env PATH.
#
# The names differ from baron_alert_geometry, which uses BARON_API_KEY and
# BARON_API_SECRET. One .env serves both folders only if it carries both pairs.

BARON_ACCESS_KEY=your_access_key
BARON_ACCESS_KEY_SECRET=your_access_secret
