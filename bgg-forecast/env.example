#rename this file to .env and populate with valid keys
#
# These scripts read the ENVIRONMENT, not this file. There is no .env loader here,
# so load it into the shell first:
#
#   set -a; source .env; set +a
#
# The variable names differ from baron_alert_geometry, which uses BARON_API_KEY /
# BARON_API_SECRET. The two below are the names geotiff_fetch.py and
# fetch_all_bgg.sh actually read.

BARON_ACCESS_KEY=your_access_key
BARON_ACCESS_KEY_SECRET=your_access_secret
