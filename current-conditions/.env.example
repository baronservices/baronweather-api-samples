# Baron Velocity Weather API credentials.
# Copy this file to .env and add your own key and secret.
#   cp .env.example .env
#
# The script reads this file and nothing else. The environment is deliberately not
# read, so exporting these as environment variables has no effect.
#
# The file is looked for in the current working directory first, then beside the
# script, so the tool works from any directory. Override with --env PATH.

BARON_API_KEY=your_access_key
BARON_API_SECRET=your_access_secret
BARON_API_BASE_URL=https://api.velocityweather.com
