#rename this file to .env and populate with valid keys
#
# baron_geotiff.py reads this file directly. Do not export these as environment
# variables — the environment is deliberately not read, so an exported value has
# no effect.
#
# The file is looked for in the current working directory first, then beside the
# script, so the tool works from any directory. Override with --env PATH.
#
# Either name pair works. BARON_API_KEY / BARON_API_SECRET matches
# baron_alert_geometry and is checked first; BARON_ACCESS_KEY /
# BARON_ACCESS_KEY_SECRET matches bgg-forecast and is the fallback. Carrying both
# pairs lets one .env serve every folder in this repository.

BARON_API_KEY=your_access_key
BARON_API_SECRET=your_access_secret

# Optional. Defaults to https://api.velocityweather.com/v1. The version segment is
# added when it is absent, so either form of the host works.
BARON_API_BASE_URL=https://api.velocityweather.com
