# Baron Velocity Weather API credentials.
# Copy this file to .env and add your own key and secret.
#   cp .env.example .env
#
# The scripts also accept these as environment variables, which take priority
# over the file.

BARON_API_KEY=your_access_key
BARON_API_SECRET=your_access_secret
BARON_API_BASE_URL=https://api.velocityweather.com
