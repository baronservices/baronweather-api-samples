# Copy this file to .env and fill in valid credentials.
#   cp env.example .env
#
# The tools read .env from this folder. To keep the file somewhere else, set
# SIGWX_ENV_FILE to its path in the shell. A variable already set in the shell
# takes precedence over the file.
#
# Only BARON_ACCESS_KEY / BARON_ACCESS_KEY_SECRET work here. BARON_API_KEY and
# BARON_API_SECRET are not read.

BARON_ACCESS_KEY=your_access_key
BARON_ACCESS_KEY_SECRET=your_access_secret

# Optional. The port of the interactive chart (default 8787) and the path to the
# Chrome program, if the tool cannot find Chrome.
# PORT=8787
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
