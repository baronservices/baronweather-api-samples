{
  "output": "style-satellite-bold.png",
  "product": "sigwx",
  "level": "high",
  "valid": "current",
  "center": { "lat": 15, "lon": 45 },
  "zoom": 3.3,
  "basemap": "satellite",
  "legend": true,
  "key": true,
  "width": 1440,
  "height": 900,
  "style": {
    "fonts": { "mapBold": "Metropolis Bold" },
    "symbols": { "color": "#ffffff", "halo": "#000", "haloWidth": 2 },
    "jets": {
      "line": { "color": "#ffffff", "width": 5 },
      "casing": { "color": "#000", "width": 9 },
      "label": { "color": "#ffffff", "halo": "#000", "haloWidth": 2, "size": 14 }
    },
    "turbulence": {
      "moderate": { "fill": "#ffffff", "opacity": 0.15 },
      "severe": { "fill": "#ffffff", "opacity": 0.3 },
      "outline": { "color": "#ffffff", "width": 3 },
      "casing": { "color": "#000", "width": 6.5 }
    },
    "hatch": { "color": "#fff", "edge": "#000" },
