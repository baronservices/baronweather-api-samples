    "callouts": { "fill": "#000", "color": "#fff", "border": "#fff", "leader": { "color": "#fff", "casing": "#000" } },
    "legend": { "background": "#000", "color": "#fff", "border": "#fff" },
    "key": { "background": "#0b0b0b", "color": "#f5f5f5", "headingColor": "#ff4040", "noteColor": "#bbbbbb", "ruleColor": "#333333" },
    "panel": { "background": "#000000" }
  }
